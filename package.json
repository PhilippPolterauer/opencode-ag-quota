{
    "name": "opencode-ag-quota",
    "version": "1.0.0",
    "description": "Opencode plugin to display Antigravity quotas",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "bun scripts/build.ts",
        "build-tsc": "bun tsc -p tsconfig.build.json",
        "dev": "tsc --watch",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "test": "vitest",
        "typecheck": "tsc --noEmit",
        "show-quota": "bun src/show-quota.ts",
        "mock-server": "bun src/mock-ag-server.ts --csrf_token mock-csrf-token-12345 --extension_server_port 46367"
    },
    "keywords": [
        "opencode",
        "plugin",
        "antigravity",
        "quota"
    ],
    "author": "Philipp",
    "license": "MIT",
    "type": "module",
    "devDependencies": {
        "@opencode-ai/plugin": "^1.1.3",
        "@opencode-ai/sdk": "^1.1.3",
        "@types/node": "^25.0.3",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "opencode-quota-display": "."
    }
}
